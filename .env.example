# Copy to .env.local; configure the same values in Vercel. Event defaults:
EVENT_SLUG=ai-world-fair-2026
EVENT_NAME="AI World Fair 2026"
EVENT_URL=https://www.ai.engineer/worldsfair/2026
EVENT_BRAND_HOST=Auth0
EVENT_BRAND_SHORT_NAME=AIE
EVENT_TAGLINE="AI Engineer · San Francisco"
# Optional; otherwise derived from the brand.
# EVENT_DESCRIPTION="Your event description"
# Public deployment origin for wall and drawing links. Falls back to APP_BASE_URL,
# then https://party-animals-xi.vercel.app when neither is configured.
EVENT_SITE_URL=http://localhost:3000
# Optional legacy override for the issue wall link only.
# NEXT_PUBLIC_WALL_URL=https://your-event.example/wall
EVENT_ISSUE_LABEL=ai-world-fair
GITHUB_ISSUE_REPO=focusotter/party-animals-gallery
EVENT_VIDEO_PROMPT="Animate this party animal drawing — make it fun and bouncy but keep many of the details of the drawing. If the drawing includes text, use that as additional context for the animation but do not include that text in the resulting video."

# Required Neon Postgres connection string; schema is created automatically.
DATABASE_URL=postgresql://user:password@your-neon-host/database?sslmode=require

# Required Auth0 application credentials. Generate secret: openssl rand -hex 32
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_SECRET=replace-with-a-random-64-character-hex-secret
APP_BASE_URL=http://localhost:3000
# GitHub-backed Auth0 connection name for login and Token Vault Connect.
AUTH0_TOKEN_VAULT_CONNECTION=github

# Independent, additive grants. Replace ALL defaults for a new event owner.
# Comma-separated lists (except domain). Empty string disables a grant type.
ADMIN_GITHUB_LOGIN=mtliendo,focusotter
ADMIN_EMAIL=
ADMIN_EMAIL_DOMAIN=focusotter.com
ADMIN_NAMES="focus otter"
ADMIN_NAME_CONTAINS=moises,liendo

# Required for animation. Model is optional; built-in models are fallback choices.
XAI_API_KEY=your-xai-key
XAI_VIDEO_MODEL=grok-imagine-video
# Required Vercel Blob read/write token.
PARTY_ANIMAL_BLOB_READ_WRITE_TOKEN=your-blob-token
# Optional server fallback when no Token Vault/login token is available.
# GITHUB_POSTING_TOKEN=your-github-token
